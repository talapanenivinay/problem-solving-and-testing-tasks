import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        Deque<Integer> deque = new ArrayDeque<>();

        int maxUnique = 0;

        for (int i = 0; i < n; i++) {
            int x = sc.nextInt();

            deque.addLast(x);

            // If window size becomes greater than k
            if (deque.size() > k) {
                deque.removeFirst();
            }

            // Count unique elements in current window
            if (deque.size() == k) {
                HashSet<Integer> set = new HashSet<>(deque);

                maxUnique = Math.max(maxUnique, set.size());
            }
        }

        System.out.println(maxUnique);

        sc.close();
    }
}
